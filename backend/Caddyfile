{$DOMAIN} {
	encode gzip

	# веб-версия приложения для проверки (iPhone без установки): /app/
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/app
		header Cache-Control "no-cache"
		file_server
	}

	# админка (/panel), API, статика Django, ассеты админки
	@backend path /panel /panel/* /api/* /django-admin/* /static/* /assets/* /media/*
	handle @backend {
		reverse_proxy admin:80
	}

	# векторные тайлы карты (planetiler, уже сжаты gzip), стили и шрифты подписей
	handle /map/t/* {
		root * /srv/site
		header Content-Type application/x-protobuf
		header Content-Encoding gzip
		header Cache-Control "public, max-age=604800"
		header Access-Control-Allow-Origin *
		file_server
	}
	handle /map/* {
		root * /srv/site
		header Cache-Control "public, max-age=3600"
		header Access-Control-Allow-Origin *
		file_server
	}

	# сайт-визитка на корне
	handle {
		root * /srv/site
		header Cache-Control "no-cache"
		file_server
	}
}
